#!/bin/sh
# ---------------------------------------------------------------------------
# custosctl —— Custos 管理器统一命令行入口（scripts/deploy.sh 的 superset）
#
# 安装：sudo ./scripts/install-custosctl.sh   → 写入 /usr/bin/custosctl
#                                               + /etc/custos/custosctl.env
# 卸载：sudo custosctl uninstall [--purge]    → 同时删除 /usr/bin/custosctl
#
# 项目目录（docker compose 上下文）按以下顺序确定：
#   1) 环境变量 CUSTOS_HOME
#   2) /etc/custos/custosctl.env 中的 CUSTOS_HOME（安装时写入）
#   3) 常见安装路径探测（/opt/Custos-HA 等）
#   4) 当前目录（若含 docker-compose.yml）
#
# 版本号唯一来源：.env 的 VERSION=。
# 未识别的子命令原样透传给 docker compose（保持与 scripts/deploy.sh 兼容）。
# ---------------------------------------------------------------------------
set -eu

PROG=$(basename "$0")
SVC=custos-server
CONF=${CUSTOS_CONF:-/etc/custos/custosctl.env}
HOME_SRC=""

# ---- 0. 全局选项：-C/--dir <项目目录> 显式指定（优先级最高）----
if [ $# -gt 0 ]; then
  case "$1" in
    -C|--dir)
      if [ $# -lt 2 ]; then echo "错误：$1 需要跟上项目目录。" >&2; exit 1; fi
      CUSTOS_HOME=$2; HOME_SRC="命令行 -C"; shift 2 ;;
  esac
fi

# 0.5 脚本自身所在目录优先：./custosctl 在仓库根直接定位（优先级高于容器标签/常见路径探测）
PROG_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
if [ -z "${CUSTOS_HOME:-}" ] && [ -n "$PROG_DIR" ] && [ -f "$PROG_DIR/docker-compose.yml" ] && [ -f "$PROG_DIR/custosctl" ]; then
  CUSTOS_HOME=$PROG_DIR; HOME_SRC="脚本所在目录"
fi

# ===========================================================================
# 节点控制分支（custosctl node <cmd>）：控制【数据库节点】，与管理器互不干扰
#   节点包结构（见节点部署改造）：docker-compose.yaml / keepalived/ /
#     <db>/conf/ / <db>/scripts/ / agent/ / logs(软链)
#   docker 节点：DB 在容器；裸机节点：DB 由 systemd(mariadb.service) 管理，
#   包内 compose 仅含 keepalived + custos-node-agent 容器。
# ===========================================================================
node_main() {
  local ndir sub data_base flavor is_docker db_svc dump_args sock_path target out ts f force tmp
  ndir=$(pwd)
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) ndir=$2; shift 2 || true ;;
      *) break ;;
    esac
  done
  sub=${1:-}; [ $# -gt 0 ] && shift || true

  if [ ! -d "$ndir" ]; then
    echo "错误：节点包目录不存在：$ndir" >&2; exit 1
  fi
  cd "$ndir" || exit 1

  # 风味检测：mysql8.0/conf → mysql；mariadb12.3.3/conf → mariadb
  flavor=""; data_base=""
  if [ -d mysql8.0/conf ]; then flavor=mysql; data_base=mysql8; fi
  if [ -d mariadb12.3.3/conf ]; then flavor=mariadb; data_base=mariadb12; fi
  if [ -z "$flavor" ]; then
    echo "错误：未在 $ndir 识别到节点包（缺少 mysql8.0/conf 或 mariadb12.3.3/conf）。" >&2
    exit 1
  fi
  # 以 compose 中真实数据目录基名覆盖默认（兼容自定义数据目录）
  dd=$(grep -oE '/data/custos-ha/[A-Za-z0-9._-]+:/var/lib/(mysql|mariadb)' docker-compose.yml 2>/dev/null | head -1 | cut -d: -f1 | xargs basename 2>/dev/null || true)
  [ -n "$dd" ] && data_base=$dd
  # docker 节点判定：compose 顶层含 mysql/mariadb 服务
  is_docker=0
  if grep -qE '^[[:space:]]*(mysql|mariadb):[[:space:]]*$' docker-compose.yml 2>/dev/null; then is_docker=1; fi
  db_svc=$( [ "$flavor" = "mariadb" ] && echo mariadb || echo mysql )
  dump_args="--single-transaction --routines --events --all-databases"
  sock_path="/data/custos-ha/$data_base/mysql.sock"

  node_usage() {
    cat <<EOF
用法: $PROG node <命令> [--dir <节点包目录>]
  install                部署节点（docker: docker compose up -d；裸机: 运行 Install 脚本），并建 logs 软链、自装 custosctl
  start                  启动（docker: up -d；裸机: systemctl start mariadb keepalived）
  stop                   停止（docker: down；裸机: systemctl stop mariadb keepalived）
  restart                重启（docker: down && up -d；裸机: systemctl restart）
  restart-keepalived     重启 keepalived（docker: compose restart keepalived；裸机: systemctl restart keepalived）
  status                 容器/服务状态 + 日志软链信息
  backup [--target <dir>]  本地备份 → <dir>/<flavor>-<ts>.sql.gz（docker: compose exec；裸机: 本地客户端）
  restore <file>         本地恢复（docker: compose exec；裸机: 本地客户端重放）
  uninstall [-f]         卸载（docker: down[ + -f 删数据]；裸机: Uninstall 脚本[ + -f 删安装目录]）
EOF
  }
  link_logs() {
    local t="/data/custos-ha/logs/$data_base"
    mkdir -p "$t" 2>/dev/null || true
    if [ -L logs ]; then rm -f logs
    elif [ -d logs ]; then rmdir logs 2>/dev/null || mv -f logs "logs.$(date +%s).bak"
    fi
    ln -sfn "$t" logs
    echo "已建日志软链：logs -> $t"
  }
  dump_bin() { [ "$flavor" = "mariadb" ] && echo mariadbdump || echo mysqldump; }
  cli_bin()  { [ "$flavor" = "mariadb" ] && echo mariadb || echo mysql; }

  case "$sub" in
    install)
      if [ "$is_docker" = 1 ]; then
        docker compose up -d || { echo "docker compose up -d 失败" >&2; exit 1; }
      else
        # 兼容两种节点包布局（节点部署目录归整前后）：
        #   新：<db>/scripts/Install-*-Node.sh（<db> 如 mariadb12.3.3 / mysql8.0）
        #   旧：Install-*-Node.sh 直接在节点包根
        inst=""
        inst=$(ls "${flavor}"*/scripts/Install-*-Node.sh 2>/dev/null | head -1)
        [ -z "$inst" ] && inst=$(ls Install-*-Node.sh 2>/dev/null | head -1)
        if [ -z "$inst" ]; then
          echo "错误：未找到裸机节点安装脚本（期望 <db>/scripts/Install-*-Node.sh 或节点包根 Install-*-Node.sh）。" >&2
          echo "请确认在节点包根目录执行；若节点包是旧版，请用最新管理器重新生成（regen）后重试。" >&2
          exit 1
        fi
        sh "$inst" || { echo "Install 脚本失败：$inst" >&2; exit 1; }
      fi
      link_logs
      if [ "$(id -u)" = "0" ]; then
        install -m 0755 "$(command -v custosctl 2>/dev/null || echo "$0")" /usr/bin/custosctl 2>/dev/null \
          || install -m 0755 "$0" /usr/bin/custosctl 2>/dev/null || true
        echo "已自装 custosctl 到 /usr/bin/custosctl"
      else
        echo "提示：非 root，未自装 custosctl；如需请 sudo custosctl node install"
      fi
      ;;
    start)
      if [ "$is_docker" = 1 ]; then docker compose up -d
      else systemctl start mariadb keepalived 2>/dev/null || systemctl start mariadb.service keepalived.service 2>/dev/null || true; fi
      ;;
    stop)
      if [ "$is_docker" = 1 ]; then docker compose down
      else systemctl stop mariadb keepalived 2>/dev/null || true; fi
      ;;
    restart)
      if [ "$is_docker" = 1 ]; then docker compose down && docker compose up -d
      else systemctl restart mariadb keepalived 2>/dev/null || true; fi
      ;;
    restart-keepalived)
      if [ "$is_docker" = 1 ]; then docker compose restart keepalived
      else systemctl restart keepalived 2>/dev/null || systemctl restart keepalived.service 2>/dev/null || true; fi
      ;;
    status)
      if [ "$is_docker" = 1 ]; then docker compose ps; else systemctl status mariadb keepalived --no-pager 2>/dev/null || true; fi
      echo "风味      : $flavor"
      echo "日志软链  : ${ndir%/}/logs -> /data/custos-ha/logs/$data_base"
      ;;
    backup)
      target="$ndir"; ts=$(date +%Y%m%d_%H%M%S)
      while [ $# -gt 0 ]; do case "$1" in --target) target=$2; shift 2 || true ;; *) break ;; esac; done
      mkdir -p "$target"
      out="$target/$flavor-$ts.sql.gz"
      echo "==> 备份到 $out"
      if [ "$is_docker" = 1 ]; then
        docker compose exec -T "$db_svc" "$(dump_bin)" $dump_args | gzip > "$out"
      else
        tmp=$(mktemp)
        if "$(dump_bin)" --socket="$sock_path" $dump_args > "$tmp" 2>"$tmp.err"; then
          gzip -c "$tmp" > "$out"
        elif [ -x "/opt/$flavor/bin/$(dump_bin)" ] && "/opt/$flavor/bin/$(dump_bin)" --socket="$sock_path" $dump_args > "$tmp" 2>"$tmp.err"; then
          gzip -c "$tmp" > "$out"
        else
          echo "裸机备份失败：$(cat "$tmp.err" 2>/dev/null)" >&2; rm -f "$tmp" "$tmp.err"; exit 1
        fi
        rm -f "$tmp" "$tmp.err"
      fi
      ls -lh "$out"
      ;;
    restore)
      f=${1:-}
      if [ -z "$f" ] || [ ! -f "$f" ]; then echo "用法：custosctl node restore <file.sql[.gz]>" >&2; exit 1; fi
      echo "==> 从 $f 恢复"
      if [ "$is_docker" = 1 ]; then
        if [ "${f%.gz}" != "$f" ]; then gunzip -c "$f" | docker compose exec -T "$db_svc" "$(cli_bin)"; else cat "$f" | docker compose exec -T "$db_svc" "$(cli_bin)"; fi
      else
        if [ "${f%.gz}" != "$f" ]; then gunzip -c "$f" | "$(cli_bin)" --socket="$sock_path"; else cat "$f" | "$(cli_bin)" --socket="$sock_path"; fi
      fi
      ;;
    uninstall)
      force=0
      for a in "$@"; do [ "$a" = "-f" ] && force=1; done
      if [ "$is_docker" = 1 ]; then
        docker compose down
        if [ "$force" = 1 ]; then rm -rf "/data/custos-ha/$data_base"; echo "已删除数据目录 /data/custos-ha/$data_base"; fi
      else
        sh "$flavor"12.3.3/scripts/Uninstall-mariadb-Node.sh "$@"
      fi
      ;;
    *) node_usage ;;
  esac
}

# ---- 节点控制优先分发（不触发管理器目录发现）----
if [ "${1:-}" = "node" ]; then
  shift
  node_main "$@"
  exit $?
fi

# ---- 1. 定位项目目录 ----
# 每个人安装路径都不同，故不猜固定路径，按「可靠性降序」多级发现：
#   ① 命令行 -C / ② 环境变量 CUSTOS_HOME / ③ /etc/custos/custosctl.env（安装时写入）
#   ④ 从运行中的容器反查（compose 写入的 working_dir 标签，最贴合实际部署）
#   ⑤ 常见安装路径探测 / ⑥ 当前目录及其父级
CUSTOS_HOME_ENV="${CUSTOS_HOME:-}"
[ -r "$CONF" ] && . "$CONF" || true
if [ -n "${CUSTOS_HOME:-}" ] && [ -z "$HOME_SRC" ]; then
  if [ -n "${CUSTOS_HOME_ENV:-}" ]; then HOME_SRC="环境变量 CUSTOS_HOME"; else HOME_SRC="$CONF"; fi
fi

if [ -z "${CUSTOS_HOME:-}" ] || [ ! -f "$CUSTOS_HOME/docker-compose.yml" ]; then
  for _c in $SVC $(docker ps --format '{{.Names}}' 2>/dev/null || true); do
    _d=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$_c" 2>/dev/null || true)
    if [ -n "$_d" ] && [ -f "$_d/docker-compose.yml" ] && [ -f "$_d/custosctl" ]; then
      CUSTOS_HOME=$_d; HOME_SRC="容器标签($_c)"; break
    fi
  done
fi

if [ -z "${CUSTOS_HOME:-}" ] || [ ! -f "$CUSTOS_HOME/docker-compose.yml" ]; then
  for d in /opt/Custos-HA /opt/custos /srv/Custos-HA /usr/local/Custos-HA "$HOME/Custos-HA"; do
    if [ -f "$d/docker-compose.yml" ]; then CUSTOS_HOME=$d; HOME_SRC="常见路径探测"; break; fi
  done
fi

if [ -z "${CUSTOS_HOME:-}" ] || [ ! -f "$CUSTOS_HOME/docker-compose.yml" ]; then
  _p=$(pwd)
  _i=0
  while [ $_i -lt 8 ]; do
    if [ -f "$_p/docker-compose.yml" ]; then
      CUSTOS_HOME=$_p; HOME_SRC="当前目录/父级"; break
    fi
    [ "$_p" = "/" ] && break
    _p=$(dirname "$_p"); _i=$((_i + 1))
  done
fi

if [ -z "${CUSTOS_HOME:-}" ] || [ ! -f "$CUSTOS_HOME/docker-compose.yml" ]; then
  echo "错误：未能定位 Custos 项目目录（需含 docker-compose.yml 与 custosctl）。" >&2
  echo "任选一种方式即可：" >&2
  echo "  1) custosctl -C <项目目录> status" >&2
  echo "  2) cd <项目目录> && custosctl status" >&2
  echo "  3) 重新执行安装以记录路径：sudo <项目目录>/scripts/install-custosctl.sh" >&2
  echo "  4) 手动写入：echo 'CUSTOS_HOME=<项目目录>' | sudo tee $CONF" >&2
  exit 1
fi
cd "$CUSTOS_HOME"

# ---- 2. 环境校验（沿用 scripts/deploy.sh 的中文提示）----
ENV_FILE=".env"
if [ ! -f "$ENV_FILE" ]; then
  if [ -f "env.example" ]; then
    cp env.example .env
    echo "提示：未找到 .env，已由 env.example 生成，请按需修改后再部署。" >&2
  else
    echo "错误：找不到 $ENV_FILE，也没有 env.example 模板。" >&2
    exit 1
  fi
fi
VERSION=$(grep -E '^VERSION=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2 | tr -d ' \t\r\n')
if [ -z "$VERSION" ]; then
  echo "错误：$ENV_FILE 中未找到 VERSION=，请先设置版本号。" >&2
  exit 1
fi
export VERSION

if [ ! -f "Dockerfile" ]; then
  echo "错误：项目目录中找不到 Dockerfile（$CUSTOS_HOME）。" >&2
  echo "请确认已完整检出（Dockerfile / docker-entrypoint.sh / requirements.txt / app/）。" >&2
  exit 1
fi

COMPOSE="docker compose"

# Web 端口：优先 .env，其次 docker-compose.yml，最后默认 28888
web_port() {
  p=$(grep -E '^ *WEB_PORT=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2 | tr -d ' \t\r\n"'"'"'')
  [ -n "$p" ] || p=$(grep -oE 'WEB_PORT: *"?[0-9]+' docker-compose.yml 2>/dev/null | head -1 | grep -oE '[0-9]+')
  echo "${p:-28888}"
}

usage() {
  cat <<EOF
用法: $PROG [-C <项目目录>] <命令> [参数]

全局选项
  -C, --dir <目录>     显式指定 Custos 项目目录（最高优先级）
                       不指定时按：环境变量 CUSTOS_HOME → /etc/custos/custosctl.env
                       → 运行中容器的 compose 标签 → 常见路径 → 当前目录/父级，自动发现
                       （custosctl status 会显示目录来源）

部署 / 生命周期
  deploy|up [-d] [--build]   构建并后台启动（默认命令；--build 强制重建镜像）
  rebuild                    重建【管理器镜像】并重启（= up -d --build，改完 app/ 必做）
  start                      创建并启动容器（= docker compose up -d）
  stop                       停止并移除容器（= docker compose down）
  restart                    先 down 再 up -d（不重建镜像）
  down [--volumes]           停止并移除容器（--volumes 连匿名卷一起删）

查看 / 排障
  status                     版本 + 容器状态 + 启动时间 + Web 端口探活
  ps                         容器列表（等价 docker compose ps）
  tail [-n N] [--no-follow]  跟踪管理器日志（默认 -n 200 并跟随）
  logs                       tail 的别名
  shell                      进入管理器容器
  version                    显示当前版本（读 .env）

节点运维
  rebuild-node --host IP --port 3306 --cluster ID
                             触发从库在线重建（走管理器 API，等同界面「重建」）

安装 / 卸载
  install                    安装自身到 /usr/bin/custosctl（需 root）
  uninstall [-f|--purge] [--yes]
                             卸载管理器：停并移除容器 + 删除本项目镜像与匿名卷
                             + 删除 /usr/bin/custosctl 与 /etc/custos
                             -f/--purge 额外【永久删除】backups/ data/ generated_nodes/
                             （含 data/custos-ha/），需输入 DELETE 二次确认
                             两种模式都【不动被管节点】上的数据库与 keepalived

其他
  help                       显示本帮助
  <任意 docker compose 子命令>  原样透传（如 $PROG config、$PROG images）

示例
  sudo $PROG rebuild                 # 改完 app/ 代码后必须执行
  $PROG status
  $PROG tail -n 500
  $PROG rebuild-node --host 192.0.2.13 --port 3306 --cluster 1
EOF
}

cmd=${1:-}
[ $# -gt 0 ] && shift || true

case "$cmd" in
  ""|help|-h|--help)
    usage
    ;;

  version|--version|-v)
    echo "$VERSION"
    ;;

  deploy|up)
    mode="up -d"
    for a in "$@"; do
      case "$a" in
        --build|-b) mode="up -d --build" ;;
      esac
    done
    echo "==> 版本 $VERSION（来源 $ENV_FILE）"
    exec $COMPOSE $mode $SVC
    ;;

  # 「重建」在本项目里是高频词，统一指【重建管理器镜像并重启】；
  # 从库数据重建请用 rebuild-node，避免歧义。
  rebuild)
    echo "==> 重建管理器镜像 版本 $VERSION"
    exec $COMPOSE up -d --build $SVC
    ;;

  # 语义（按运维习惯统一，均不重建镜像；重建镜像用 rebuild）：
  #   start   = up -d      （创建并启动）
  #   stop    = down       （停止并移除容器）
  #   restart = down && up -d
  start)
    exec $COMPOSE up -d
    ;;

  stop)
    exec $COMPOSE down
    ;;

  restart)
    $COMPOSE down && exec $COMPOSE up -d
    ;;

  down)
    exec $COMPOSE down "$@"
    ;;

  ps)
    exec $COMPOSE ps
    ;;

  tail|logs)
    n=200
    follow=1
    while [ $# -gt 0 ]; do
      case "$1" in
        -n|--lines)   n=${2:-200}; shift 2 || true ;;
        --no-follow)  follow=0; shift ;;
        *)            break ;;
      esac
    done
    if [ "$follow" = "1" ]; then
      exec $COMPOSE logs -f --tail="$n" $SVC
    else
      exec $COMPOSE logs --tail="$n" $SVC
    fi
    ;;

  shell)
    exec $COMPOSE exec $SVC sh
    ;;

  status)
    echo "版本      : $VERSION"
    echo "项目目录  : $CUSTOS_HOME  （来源：${HOME_SRC:-默认}）"
    echo "服务      : $SVC"
    st=$(docker inspect -f '{{.State.Status}}' $SVC 2>/dev/null || echo "未运行/不存在")
    up=$(docker inspect -f '{{.State.StartedAt}}' $SVC 2>/dev/null || echo "-")
    echo "容器状态  : $st"
    echo "启动时间  : $up （UTC，+8 为北京时间）"
    $COMPOSE ps || true
    p=$(web_port)
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:$p/login" 2>/dev/null || echo "-")
    echo "管理端    : http://127.0.0.1:$p  （HTTP $code）"
    ;;

  rebuild-node)
    n_host=""
    n_port=3306
    n_cid=""
    n_url="http://127.0.0.1:$(web_port)"
    n_user=$(grep -E '^ *WEB_USER=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2 | tr -d ' \t\r\n"'"'"'')
    n_pass=$(grep -E '^ *WEB_PASS=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2 | tr -d ' \t\r\n"'"'"'')
    while [ $# -gt 0 ]; do
      case "$1" in
        --host)    n_host=$2; shift 2 ;;
        --port)    n_port=$2; shift 2 ;;
        --cluster) n_cid=$2;  shift 2 ;;
        --url)     n_url=$2;  shift 2 ;;
        --user)    n_user=$2; shift 2 ;;
        --pass)    n_pass=$2; shift 2 ;;
        *) echo "未知参数：$1（rebuild-node 支持 --host --port --cluster --url --user --pass）" >&2; exit 1 ;;
      esac
    done
    if [ -z "$n_host" ] || [ -z "$n_cid" ]; then
      echo "用法：$PROG rebuild-node --host <节点IP> --cluster <集群ID> [--port 3306]" >&2
      exit 1
    fi
    command -v curl >/dev/null 2>&1 || { echo "错误：需要 curl 才能调用管理器 API。" >&2; exit 1; }
    ck=$(mktemp)
    # 登录拿会话 cookie
    curl -sS -c "$ck" -o /dev/null -X POST \
      -d "username=$n_user" -d "password=$n_pass" "$n_url/login" || {
        echo "登录管理器失败（检查 .env 的 WEB_USER/WEB_PASS 或 --url）" >&2; rm -f "$ck"; exit 1; }
    res=$(curl -sS -b "$ck" -X POST \
      -d "cluster_id=$n_cid" -d "host=$n_host" -d "port=$n_port" \
      "$n_url/api/node/rebuild") || res=""
    rm -f "$ck"
    echo "$res"
    case "$res" in
      *'"ok":true'*|*'"ok": true'*) echo "已提交重建任务（$n_host:$n_port）；进度见界面右下角或 $PROG tail" ;;
      *) echo "提交失败：请检查集群/节点是否正确、该节点是否为非主库节点。" >&2; exit 1 ;;
    esac
    ;;

  install)
    exec sh "$CUSTOS_HOME/scripts/install-custosctl.sh" "$@"
    ;;

  uninstall)
    exec sh "$CUSTOS_HOME/scripts/uninstall.sh" "$@"
    ;;

  *)
    # 未识别：原样透传给 docker compose（兼容 scripts/deploy.sh 的用法）
    exec $COMPOSE "$cmd" "$@"
    ;;
esac
