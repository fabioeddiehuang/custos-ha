__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.DS_Store

# 集群备份产物（含业务数据 SQL 转储，切勿入库）
backups/

# 本地 compose 配置备份（含真实地址，切勿入库）
docker-compose.yml.bak.*

# 本地环境变量（.env）：**切勿入库（不通过 git 上传）！**
# 虽经 v2.3.9 去密（SECRET_KEY / WEB_PASS / MGMT_MYSQL_PASS 已移出本文件），但本文件
# 仍含真实部署拓扑（内网 IP / VIP / 管理库地址 / 网卡 / VRID 等），属环境敏感信息。
# 仓库仅保留脱敏模板 env.example；新环境部署：cp env.example .env 再按需修改。
.env
# 运行时数据（含会话密钥文件 data/secret_key）
data/
# 节点部署单元（内含明文密码）
generated_nodes/

# 节点镜像 tar（v2.5.0 F2 镜像内部分发）：由 scripts/build_node_images.sh 构建生成，
# 首次安装时自动产出到 ./images/（服务端下发给节点供 curl 引导 docker load 用）。
# 属【构建产物】且每个约 70MB —— 不入库；.dockerignore 同样已排除，避免 `COPY . .`
# 把它们打进服务端镜像（重蹈 backups/ 导致镜像膨胀到 1.27GB 的覆辙）。
images/

# 本地真实部署配置（含真实内网 IP / 管理库口令 / Web 口令，切勿入库）。
# 仓库只保留脱敏模板 docker-compose-example.yml；新环境首次部署：
#   cp docker-compose-example.yml docker-compose.yml 再按需修改。
docker-compose.yml

# 运行时日志（看门狗/agent 输出，非敏感但无需入库）
logs/

# ---------------------------------------------------------------------------
# WorkBuddy 工作区数据（本地 AI 助手产物，非项目内容，切勿入库）
# 含：记忆文件(.workbuddy/memory/)、WorkBuddy 生成的交付物/分析文档(.workbuddy/generated/)、
# 技能缓存、运行时状态等。本项目仓库只保留源码与项目自有文档，WorkBuddy 产物一律隔离在本地。
# ---------------------------------------------------------------------------
.workbuddy/

# ---------------------------------------------------------------------------
# 回归测试套件：**纳入仓库跟踪**（eddie 2026-09-16 定）
# 理由：pytest 套件是「稳定性」的实物证据与安全网，商用级仓库必须自带可复现的
# 回归能力；且其中不含任何密钥（SECRET_KEY 用固定测试串，DATA_DIR 指向 /tmp）。
# 原「仅本地回归验证、不视为交付内容」的决策已废止。
# ---------------------------------------------------------------------------
