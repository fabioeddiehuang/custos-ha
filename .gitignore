__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.DS_Store

# 集群备份产物（含业务数据 SQL 转储，切勿入库）
backups/

# 本地 compose 配置备份（含真实地址，切勿入库）
docker-compose.yml.bak.*

# 本地环境变量（VERSION / COMPOSE_PROJECT_NAME 等非密钥配置，可入库同步；
# SECRET_KEY 已改由 data/secret_key 持久化，本文件不再含密钥，故纳入 git 跟踪）
# 运行时数据（含会话密钥文件 data/secret_key）
data/
# 节点部署单元（内含明文密码）
generated_nodes/

# 本地真实部署配置（含真实内网 IP / 管理库口令 / Web 口令，切勿入库）。
# 仓库只保留脱敏模板 docker-compose-example.yml；新环境首次部署：
#   cp docker-compose-example.yml docker-compose.yml 再按需修改。
docker-compose.yml

# 运行时日志（看门狗/agent 输出，非敏感但无需入库）
logs/
