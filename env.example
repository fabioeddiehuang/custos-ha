# Custos 环境变量模板（脱敏，可安全入库）
#
# 全新部署首次安装：
#   cp env.example .env
# 然后按需修改（至少确认下面的 VERSION，以及 docker-compose.yml 中的连接信息）。
#
# 说明：
#   - docker compose 启动时会自动加载同目录的 .env（注意是 .env，不是本文件）；
#   - VERSION 是版本号唯一来源（镜像标签 + 页面显示版本号均从此读取），
#     升版只改这一处，不要去 Dockerfile / docker-compose.yml 里写死；
#   - SECRET_KEY 留空则首次启动随机生成并持久化到 ./data/secret_key，
#     生产环境建议填一个强随机值，避免容器重建导致登录态失效；
#   - 管理库连接 / 网络 / VIP 等变量在 docker-compose.yml 中已有占位默认值，
#     按 docker-compose-example.yml 的注释替换为你的真实地址即可。

# 应用版本号（务必与 README / RELEASE_NOTES 的版本一致）
VERSION=v2.3.10

# 会话签名密钥（留空=首次启动自动生成随机密钥并持久化到 ./data/secret_key）
SECRET_KEY=

# compose 项目名（可选，默认 custos）
COMPOSE_PROJECT_NAME=custos

# 弱口令开关：1=允许（默认，弱口令登录不强制改密、写操作不拦截）
#              0=安全基线：弱口令首登强制改密 + 拦截写操作
ALLOW_WEAK_PASSWORD=1
