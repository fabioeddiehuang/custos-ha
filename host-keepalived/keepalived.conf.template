# keepalived 配置模板 —— 复制到两台 DB 主机 /etc/keepalived/keepalived.conf
# 把 __LOCAL_IP__ / __PEER_IP__ / __VIP__ / __INTERFACE__ 替换为实际值
# 两台主机使用同一份模板，仅 __LOCAL_IP__ 与 __PEER_IP__ 互换
global_defs {
    router_id ha_mysql___LOCAL_IP__
    enable_script_security
}

vrrp_script chk_mysql_master {
    script "/etc/keepalived/check_mysql_master.sh"
    interval 2
    fall 2
    rise 2
}

vrrp_instance VI_MYSQL {
    state BACKUP
    interface __INTERFACE__          # 如 eth0
    virtual_router_id 51
    priority 100
    nopreempt
    advert_int 1
    unicast_src_ip __LOCAL_IP__      # 本机内网 IP
    unicast_peer {
        __PEER_IP__                  # 对端内网 IP
    }
    track_script {
        chk_mysql_master
    }
    virtual_ipaddress {
        __VIP__/24                    # VIP，如 192.168.1.10/24
    }
}
