#compdef custosctl
#
# custosctl —— zsh 原生补全（无需 bashcompinit）。
# 安装到 $fpath 中的 site-functions 目录（如 /usr/share/zsh/site-functions）
# 后由 zsh 的 compinit 自动加载，无需修改 ~/.zshrc、无需手动 source。
#
# 与 bash 版（scripts/custosctl-completion.bash）并存：bash 用后者，zsh 用本文件。

_custosctl() {
  local ret=1
  local -a commands node_commands
  commands=(
    'deploy:构建并后台启动'
    'up:构建并后台启动'
    'rebuild:重建管理器镜像并重启'
    'start:创建并启动容器'
    'stop:停止并移除容器'
    'restart:先 down 再 up -d'
    'down:停止并移除容器'
    'ps:容器列表'
    'tail:跟踪管理器日志'
    'logs:tail 别名'
    'shell:进入管理器容器'
    'status:版本+容器状态+Web 探活'
    'version:显示当前版本'
    'rebuild-node:触发从库在线重建'
    'install:安装自身到 /usr/bin'
    'uninstall:卸载管理器'
    'node:节点运维'
    'help:显示帮助'
  )
  node_commands=(
    'install:部署节点'
    'start:启动节点'
    'stop:停止节点'
    'restart:重启节点'
    'restart-keepalived:重启 keepalived'
    'status:节点状态'
    'backup:本地备份'
    'restore:本地恢复'
    'uninstall:卸载节点'
  )

  if [[ ${words[2]:-} == node ]]; then
    # node 子命令上下文
    if (( CURRENT == 3 )); then
      _describe -t ncmd 'node command' node_commands && ret=0
    else
      case ${words[3]:-} in
        backup)   _arguments '--target[目标目录]:directory:_files -/' && ret=0 ;;
        restore)  _arguments ':backup file:_files' && ret=0 ;;
        uninstall) _arguments '-f[强制删除数据]' && ret=0 ;;
        *) ret=0 ;;
      esac
    fi
  elif (( CURRENT == 2 )); then
    _describe -t cmd 'custosctl command' commands && ret=0
  else
    case ${words[CURRENT-1]:-} in
      -C|--dir) _files -/ && ret=0 ;;
      tail|logs)     _arguments '-n[行数]:lines:' '--no-follow[不跟随]' && ret=0 ;;
      deploy|up)     _arguments '-d[后台运行]' '--build[强制重建镜像]' '-b[强制重建镜像]' && ret=0 ;;
      down)          _arguments '--volumes[同时删除匿名卷]' && ret=0 ;;
      rebuild-node)  _arguments \
        '--host[节点 IP]:host:' \
        '--port[端口]:port:' \
        '--cluster[集群 ID]:cluster:' \
        '--url[管理器地址]:url:' \
        '--user[用户名]:user:' \
        '--pass[密码]:pass:' && ret=0 ;;
      uninstall)     _arguments '-f[永久删除数据]' '--purge[永久删除数据]' '--yes[跳过确认]' && ret=0 ;;
      node)          _describe -t ncmd 'node command' node_commands && ret=0 ;;
      *)
        # 命令位置（如 `custosctl -C <dir>` 之后的子命令）
        _describe -t cmd 'custosctl command' commands && ret=0 ;;
    esac
  fi
  return ret
}

_custosctl "$@"
