# Custos 运行配置（由 install.sh 生成；SECRET_KEY、WEB_PASS、MGMT_MYSQL_PASS 均不写入本文件：SECRET_KEY 由 data/secret_key 持久化，WEB_PASS 与 MGMT_MYSQL_PASS 由 docker-compose.yml 驱动）
VERSION=v2.5.1
COMPOSE_PROJECT_NAME=custos

# 管理库（仅管理器自身存储，非集群节点）
MGMT_MYSQL_HOST=192.168.1.88
MGMT_MYSQL_PORT=3306
MGMT_MYSQL_USER=ha2
MGMT_MYSQL_DB=ha2

# Web / 网络
WEB_PORT=28888
WEB_USER=admin
# 弱口令开关：1=允许（默认，弱口令登录不强制改密、写操作不拦截）；0=安全基线（强制改密+拦截写操作）
ALLOW_WEAK_PASSWORD=1
MANAGER_PUBLIC_IP=192.168.1.66
INTERFACE=eth0
VIP=
VIP_PREFIX=24
VRID=51
