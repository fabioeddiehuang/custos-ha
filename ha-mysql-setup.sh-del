#!/usr/bin/env bash
#
# ha-mysql-setup.sh — 裸机 / 宝塔 / 编译安装 的 MySQL 8.0 节点接入 HA-MySQL-Manager 的准备脚本
#
# 在【每一台】裸机 MySQL 节点上执行一次本脚本，即可完成「让管理器能从内网连上并顺利部署」所需
# 的全部 MySQL 侧修改：
#   1) 允许管理器从内网连接本机 MySQL（创建 root@'<来源IP 或 %>'，使用 mysql_native_password）
#   2) 监听所有网卡（bind-address = 0.0.0.0）——宝塔默认只绑 127.0.0.1，是连不上最常见原因
#   3) 写入 GTID / binlog 等关键复制参数（追加到 my.cnf 的 [mysqld]，绕开宝塔重启重写 my.cnf）
#   4) 放行防火墙（MySQL 端口 + keepalived 的 VRRP 协议 112）
#   5) 可选：执行管理器生成的 init_baremetal.sql（创建 ha_monitor / replication / app 账号）
#   6) 可选：启动 keepalived 客户端容器（需本机已装 docker）
#   7) 自检参数并给出「下一步在管理器 Web 添加节点」的提示
#
# 适用：MySQL 8.0.x（含 8.4）。不支持 MariaDB（本管理器基于 MySQL GTID 实现）。
#
# 用法示例：
#   sudo bash ha-mysql-setup.sh -p 'MySQL的root密码'
#   sudo bash ha-mysql-setup.sh -p '密码' -m 192.168.1.10        # 仅允许来自管理器的连接（更严）
#   sudo bash ha-mysql-setup.sh -p '密码' -i /root/init_baremetal.sql
#   sudo bash ha-mysql-setup.sh -p '密码' -c /home/docker/192.168.1.203   # 顺便拉起 keepalived
#   sudo bash ha-mysql-setup.sh -p '密码' --skip-restart        # 自己用宝塔/面板重启 MySQL
#
set -euo pipefail

# ---------- 默认参数 ----------
ROOT_PASS=""
MANAGER_IP=""          # 空 = 允许任意来源 '%'
PORT=""                # 空 = 自动探测
SERVER_ID=""           # 空 = 自动生成（取本机 IP 末段，失败则随机）
INIT_SQL=""            # init_baremetal.sql 路径（可选）
COMPOSE_DIR=""         # 已解压的生成节点目录（可选，用于启动 keepalived）
SKIP_RESTART=0

# ---------- 解析参数 ----------
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--root-pass)    ROOT_PASS="$2"; shift 2;;
    -m|--manager-ip)   MANAGER_IP="$2"; shift 2;;
    -P|--port)         PORT="$2"; shift 2;;
    -s|--server-id)    SERVER_ID="$2"; shift 2;;
    -i|--init-sql)     INIT_SQL="$2"; shift 2;;
    -c|--compose-dir)  COMPOSE_DIR="$2"; shift 2;;
    --skip-restart)    SKIP_RESTART=1; shift;;
    -h|--help)         sed -n '2,28p' "$0"; exit 0;;
    *) echo "未知参数: $1"; exit 1;;
  esac
done

# ---------- 工具函数 ----------
log(){ echo -e "\033[1;32m[setup]\033[0m $*"; }
warn(){ echo -e "\033[1;33m[warn]\033[0m $*"; }
err(){ echo -e "\033[1;31m[error]\033[0m $*"; }
backup(){ local f="$1"; if [[ -f "$f" ]]; then cp -a "$f" "$f.bak.$(date +%Y%m%d%H%M%S)"; log "已备份 $f"; fi; }

if [[ $EUID -ne 0 ]]; then
  err "请使用 root 执行：sudo bash $0 ..."; exit 1
fi
if [[ -z "$ROOT_PASS" ]]; then
  err "必须提供 MySQL root 密码（-p '密码'）：管理器需凭此从内网连接本节点。"; exit 1
fi

# ---------- 定位 MySQL 客户端（兼容宝塔 / 通用） ----------
MYSQL_BIN="$(command -v mysql || true)"
if [[ -z "$MYSQL_BIN" && -x /www/server/mysql/bin/mysql ]]; then
  MYSQL_BIN=/www/server/mysql/bin/mysql
fi
if [[ -z "$MYSQL_BIN" ]]; then
  err "未找到 mysql 客户端，请先安装或将其加入 PATH。"; exit 1
fi
log "MySQL 客户端: $MYSQL_BIN"

# ---------- 确定本地连接方式（兼容 auth_socket 免密） ----------
if "$MYSQL_BIN" -uroot -p"$ROOT_PASS" -e "SELECT 1" >/dev/null 2>&1; then
  CONN=( "$MYSQL_BIN" -uroot -p"$ROOT_PASS" )
elif "$MYSQL_BIN" -uroot -e "SELECT 1" >/dev/null 2>&1; then
  warn "本地 root 当前为 auth_socket 免密登录；将把 root 密码设为 -p 指定的密码以便远程连接。"
  "$MYSQL_BIN" -uroot -e "ALTER USER 'root'@'localhost' IDENTIFIED WITH mysql_native_password BY '${ROOT_PASS}';"
  CONN=( "$MYSQL_BIN" -uroot -p"$ROOT_PASS" )
else
  err "无法以 root 连接本地 MySQL，请确认 root 密码正确。"; exit 1
fi
SQL(){ "${CONN[@]}" "$@"; }
log "本地连接 MySQL 成功。"

# ---------- 端口 / server_id 探测 ----------
if [[ -z "$PORT" ]]; then
  PORT="$(SQL -N -e "SELECT @@port" 2>/dev/null | head -1)"
  [[ -z "$PORT" ]] && PORT=3306
fi
log "MySQL 端口: $PORT"

if [[ -z "$SERVER_ID" ]]; then
  OCTET="$(hostname -I 2>/dev/null | awk '{print $1}' | awk -F. '{print $4}')"
  if [[ "$OCTET" =~ ^[0-9]+$ && "$OCTET" -gt 0 ]]; then
    SERVER_ID="$OCTET"
  else
    SERVER_ID="$(( (RANDOM % 9000) + 1000 ))"
  fi
fi
log "server_id: $SERVER_ID  （同集群内必须唯一，请勿重复）"

# ---------- 定位 my.cnf ----------
CNF=""
for f in /www/server/mysql/my.cnf /etc/my.cnf /etc/mysql/my.cnf; do
  if [[ -f "$f" ]]; then CNF="$f"; break; fi
done
if [[ -z "$CNF" ]]; then CNF=/etc/my.cnf; warn "未找到现有 my.cnf，将新建 $CNF"; fi
log "MySQL 配置文件: $CNF"
backup "$CNF"

# ---------- 写入 GTID 片段（仅缺失时） ----------
if grep -qi "^\s*gtid_mode" "$CNF"; then
  warn "检测到已存在 gtid_mode，跳过追加 HA 片段（如参数不全请在 [mysqld] 下手动补齐）。"
else
  grep -qi "^\[mysqld\]" "$CNF" || printf '\n[mysqld]\n' >> "$CNF"
  cat >> "$CNF" <<EOF

# ---- MySQL HA Manager 裸机节点参数（$(date +%F) 由 ha-mysql-setup.sh 写入）----
server-id = ${SERVER_ID}
gtid_mode = ON
enforce_gtid_consistency = ON
log_bin = mysql-bin
log_slave_updates = ON
relay_log = relay-bin
relay_log_recovery = ON
sync_binlog = 1
innodb_flush_log_at_trx_commit = 1
read_only = ON
slow_query_log = 1
long_query_time = 0.5
log_output = TABLE
log_queries_not_using_indexes = 0
# 业务/复制端口（须与管理器「节点配置」页填写的端口一致，当前探测=${PORT}）
EOF
  log "已追加 GTID 片段到 $CNF"
fi

# ---------- bind-address = 0.0.0.0 ----------
if grep -qi "^\s*bind-address" "$CNF"; then
  sed -i 's/^\s*bind-address.*/bind-address = 0.0.0.0/' "$CNF"
  log "已将 bind-address 改为 0.0.0.0"
else
  sed -i '/^\[mysqld\]/a bind-address = 0.0.0.0' "$CNF"
  log "已新增 bind-address = 0.0.0.0"
fi

# ---------- 创建远程 root 账号（管理器用） ----------
HOST_SPEC="${MANAGER_IP:-%}"
log "创建远程账号 root@'${HOST_SPEC}'（mysql_native_password）..."
SQL -e "CREATE USER IF NOT EXISTS 'root'@'${HOST_SPEC}' IDENTIFIED WITH mysql_native_password BY '${ROOT_PASS}';"
SQL -e "GRANT ALL PRIVILEGES ON *.* TO 'root'@'${HOST_SPEC}' WITH GRANT OPTION;"
SQL -e "FLUSH PRIVILEGES;"
log "已授权 root@'${HOST_SPEC}'（管理器将用它连接本节点）。"

# ---------- 防火墙 ----------
log "配置防火墙（MySQL 端口 + VRRP 协议 112）..."
if command -v ufw >/dev/null 2>&1 && ufw status >/dev/null 2>&1; then
  ufw allow "${PORT}/tcp" >/dev/null 2>&1 && log "ufw: 放行 ${PORT}/tcp"
fi
if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active firewalld >/dev/null 2>&1; then
  firewall-cmd --permanent --add-port="${PORT}/tcp" >/dev/null 2>&1 && firewall-cmd --reload >/dev/null 2>&1 && log "firewalld: 放行 ${PORT}/tcp"
  firewall-cmd --permanent --add-protocol=vrrp >/dev/null 2>&1 && firewall-cmd --reload >/dev/null 2>&1 && log "firewalld: 放行 VRRP(112)"
fi
if command -v iptables >/dev/null 2>&1; then
  iptables -I INPUT -p tcp --dport "${PORT}" -j ACCEPT 2>/dev/null || true
  iptables -I INPUT -p vrrp -j ACCEPT 2>/dev/null || true
  log "iptables: 已放行 ${PORT}/tcp 与 VRRP(112)（iptables 规则重启可能失效，建议持久化）"
fi
if command -v ufw >/dev/null 2>&1 && ufw status >/dev/null 2>&1; then
  warn "ufw 不支持按协议放行 VRRP；若用了 ufw，请额外执行：sudo iptables -I INPUT -p vrrp -j ACCEPT（并持久化）"
fi

# ---------- 可选：执行 init_baremetal.sql ----------
if [[ -n "$INIT_SQL" ]]; then
  if [[ -f "$INIT_SQL" ]]; then
    log "执行 init_baremetal.sql（创建 ha_monitor / replication / app 账号）..."
    SQL < "$INIT_SQL" && log "init_baremetal.sql 执行完成"
  else
    warn "指定的 init-sql 不存在: $INIT_SQL（跳过；请在管理器生成后手动执行）"
  fi
fi

# ---------- 重启 MySQL ----------
if [[ $SKIP_RESTART -eq 0 ]]; then
  log "重启 MySQL ..."
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files mysqld.service >/dev/null 2>&1; then
    systemctl restart mysqld 2>/dev/null || systemctl restart mysql 2>/dev/null || true
  elif [[ -x /etc/init.d/mysqld ]]; then
    /etc/init.d/mysqld restart
  elif [[ -x /www/server/mysql/support-files/mysql.server ]]; then
    /www/server/mysql/support-files/mysql.server restart
  else
    warn "未识别 MySQL 重启方式，请手动重启（service mysql restart / 宝塔面板）。"
  fi
  sleep 3
fi

# ---------- 自检 ----------
log "自检：以 TCP(${PORT}) 模拟远程连接 + 关键参数 ..."
if SQL -h 127.0.0.1 -P "$PORT" -e "SELECT 1" >/dev/null 2>&1; then
  log "✓ MySQL 已监听 TCP ${PORT}，且 root@'${HOST_SPEC}' 可登录"
else
  warn "本地以 -h 127.0.0.1 连接失败：请检查 bind-address / 密码 / 防火墙"
fi
SQL -h 127.0.0.1 -P "$PORT" -e "SELECT @@gtid_mode AS gtid_mode, @@read_only AS read_only, @@server_id AS server_id, @@port AS port\\G" 2>/dev/null || true

# ---------- 可选：启动 keepalived 客户端 ----------
if [[ -n "$COMPOSE_DIR" ]]; then
  if [[ -f "$COMPOSE_DIR/docker-compose.yaml" || -f "$COMPOSE_DIR/docker-compose.yml" ]]; then
    if command -v docker >/dev/null 2>&1; then
      log "启动 keepalived 客户端容器..."
      ( cd "$COMPOSE_DIR" && docker compose up -d )
    else
      warn "未安装 docker，跳过 keepalived 启动（请先在节点安装 docker）。"
    fi
  else
    warn "compose 目录无 docker-compose 文件: $COMPOSE_DIR（跳过）。"
  fi
fi

# ---------- 收尾提示 ----------
echo
log "==== 本节点准备完成 ===="
echo "  • 节点 MySQL 端口（在管理器「节点配置」页填写）: $PORT"
echo "  • server_id: $SERVER_ID"
echo "  • 远程账号: root@'${HOST_SPEC}'（密码即你提供的 root 密码）"
echo
echo "下一步（在管理器 Web 上）："
echo "  1) 集群管理 → 新建/选择集群（记录 VIP、vip_port，建议 vip_port 与上面节点端口 $PORT 一致）"
echo "  2) 节点配置 → 添加节点：IP 填本机、端口填 $PORT、root 用户 root、root 密码填上面的密码、类型选「裸机」"
echo "  3) 生成后，把管理器生成的目录（generated_nodes/<本机IP>/）拷到本机 /home/docker/<本机IP>/"
echo "     其中的 init_baremetal.sql 执行一次（也可这次用 -i 指定）；docker-compose.yaml 用 docker compose up -d 跑 keepalived"
echo "  4) 各节点都准备好后，等待管理器自动建复制；或在节点页点「重新生成」时查看管理器的预检提示"
echo
warn "注意：read_only=ON 已写入配置，首台主库由管理器自动提升（SET GLOBAL read_only=0），无需手动取消只读。"
