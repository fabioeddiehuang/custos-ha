global_defs {
    router_id ${KEEPALIVED_ROUTER_ID}
}

vrrp_script chk_mysql_master {
    script "/etc/keepalived/check_mysql_master.sh"
    interval 2
    fall 2
    rise 2
    user root
}

vrrp_instance VI_MYSQL {
    state BACKUP
    interface ${KEEPALIVED_INTERFACE}
    virtual_router_id ${KEEPALIVED_VRID}
    priority 100
    nopreempt
    advert_int 1
    unicast_src_ip ${KEEPALIVED_LOCAL_IP}
    unicast_peer {
        ${KEEPALIVED_PEER_IP}
    }
    track_script {
        chk_mysql_master
    }
    virtual_ipaddress {
        ${KEEPALIVED_VIP}/${KEEPALIVED_VIP_PREFIX}
    }
}
