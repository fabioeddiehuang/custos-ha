# mysql-ha-node 手动部署示例环境变量（docker compose 自动读取）
# 必改：ROOT_PASS（节点 MySQL root 密码）；如多节点请为每台改 NODE_NAME/SERVER_ID。
# 说明：keepalived/keepalived.conf、keepalived/ha_check.conf、init.sql 已附可直接使用的示例，
#       其内的 ha_monitor / repl 密码须与本文件无直接关系，但须与「服务端配置」及彼此保持一致。
NODE_NAME=mysql-ha-node-203
NODE_PORT=3307
ROOT_PASS=node_root_pass_example
SERVER_ID=1
READ_ONLY=ON
